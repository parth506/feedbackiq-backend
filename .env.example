# =============================================================================
# FeedbackIQ — Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env to version control.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=FeedbackIQ
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=feedbackiq
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=generate-a-strong-random-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────
CACHE_TTL_DASHBOARD=300
CACHE_TTL_ANALYTICS=300
CACHE_TTL_SENTIMENT=300
CACHE_TTL_TOPICS=600
CACHE_TTL_AI_INSIGHTS=600
